# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Vector Database Configuration (Local)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant-test-key
QDRANT_COLLECTION_NAME=book-embeddings

# PostgreSQL Configuration (Local - via Docker Compose)
NEON_DB_URL=postgresql://raguser:ragpassword@postgres:5432/rag_chatbot

# Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENV=development

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://yourdomain.com"]

# RAG Configuration
TOP_K_RETRIEVAL=10
RERANKER_TOP_K=5
MAX_TOKENS_PER_QUERY=4000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Security
RATE_LIMIT_QUERIES_PER_MINUTE=60
ENABLE_SELECTION_MODE=true
